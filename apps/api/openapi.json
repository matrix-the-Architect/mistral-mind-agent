{
  "components": {
    "schemas": {
      "ArtifactEnvelopeOut": {
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "ciphertext": {
            "title": "Ciphertext",
            "type": "string"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "iv": {
            "title": "Iv",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "namespace_id",
          "generation",
          "artifact_id",
          "schema_version",
          "iv",
          "ciphertext"
        ],
        "title": "ArtifactEnvelopeOut",
        "type": "object"
      },
      "ArtifactListOut": {
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactEnvelopeOut"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "state",
          "artifacts"
        ],
        "title": "ArtifactListOut",
        "type": "object"
      },
      "ArtifactUploaded": {
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "stored",
              "exists"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "status"
        ],
        "title": "ArtifactUploaded",
        "type": "object"
      },
      "ConfigResponse": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "model_available": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Available"
          },
          "provider_origin": {
            "title": "Provider Origin",
            "type": "string"
          }
        },
        "required": [
          "configured",
          "model",
          "provider_origin",
          "model_available"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "configured": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Configured"
          },
          "reachable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reachable"
          }
        },
        "title": "DependencyStatus",
        "type": "object"
      },
      "EraseRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[0-9a-fA-F-]+$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "EraseRequest",
        "type": "object"
      },
      "ErasureResultOut": {
        "properties": {
          "artifacts_remaining": {
            "title": "Artifacts Remaining",
            "type": "integer"
          },
          "artifacts_removed": {
            "title": "Artifacts Removed",
            "type": "integer"
          },
          "completed_at": {
            "title": "Completed At",
            "type": "string"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "namespace_state": {
            "title": "Namespace State",
            "type": "string"
          },
          "requested_at": {
            "title": "Requested At",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "status",
          "artifacts_removed",
          "artifacts_remaining",
          "idempotency_key",
          "requested_at",
          "completed_at",
          "namespace_state",
          "revoked_at"
        ],
        "title": "ErasureResultOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "deployment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment"
          },
          "deps": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Deps",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "deps"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InferenceResponse": {
        "properties": {
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "model",
          "namespace_id",
          "generation"
        ],
        "title": "InferenceResponse",
        "type": "object"
      },
      "NamespaceRegistered": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "deletion_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletion Token"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "generation",
          "state",
          "created"
        ],
        "title": "NamespaceRegistered",
        "type": "object"
      },
      "NamespaceStatusOut": {
        "description": "Owner-scoped read-only status: lifecycle metadata plus the real artifact count at query time.\n\nNot a database-wide count and not a paginated-list length: ``artifact_count`` is a live\n``COUNT(*)`` scoped to this one namespace, and ``observed_at`` says when it was observed.",
        "properties": {
          "artifact_count": {
            "title": "Artifact Count",
            "type": "integer"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "namespace_id": {
            "title": "Namespace Id",
            "type": "string"
          },
          "observed_at": {
            "title": "Observed At",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "generation",
          "state",
          "artifact_count",
          "observed_at"
        ],
        "title": "NamespaceStatusOut",
        "type": "object"
      },
      "RegisterNamespaceRequest": {
        "additionalProperties": false,
        "properties": {
          "generation": {
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Generation",
            "type": "integer"
          },
          "namespace_id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "title": "Namespace Id",
            "type": "string"
          }
        },
        "required": [
          "namespace_id",
          "generation"
        ],
        "title": "RegisterNamespaceRequest",
        "type": "object"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "token"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "The app's status and each dependency's: whether Mistral is configured, whether each checked\nservice answers. ``degraded`` when one does not; the response is 200 either way.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Report dependency status; always answers 200"
      }
    },
    "/api/v1/config": {
      "get": {
        "description": "Whether the relay is configured, which model it will call, and whether that model is\nserved by the configured provider origin. Never includes the credential.",
        "operationId": "ghost_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Relay configuration and model availability",
        "tags": [
          "ghost"
        ]
      }
    },
    "/api/v1/inference": {
      "post": {
        "description": "Forward the browser's approved ``messages`` snapshot to Mistral and return the text.\n\nThe relay appends nothing: no system prompt, no history, no private context. The admitted\n``namespace_id`` and ``generation`` are echoed back so the browser can show which vault\nthe answer belongs to. The namespace must be registered, owned by this session, active and at\nthe claimed generation before anything is sent to the provider.",
        "operationId": "ghost_inference",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "One non-streaming Mistral completion",
        "tags": [
          "ghost"
        ]
      }
    },
    "/api/v1/namespaces": {
      "post": {
        "operationId": "ghost_register_namespace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterNamespaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NamespaceRegistered"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register the vault's namespace with its owner",
        "tags": [
          "ghost-memory"
        ]
      }
    },
    "/api/v1/namespaces/{namespace_id}/artifacts": {
      "get": {
        "operationId": "ghost_list_artifacts",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List the namespace's encrypted artifacts",
        "tags": [
          "ghost-memory"
        ]
      },
      "post": {
        "operationId": "ghost_upload_artifact",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactUploaded"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload one encrypted artifact (idempotent)",
        "tags": [
          "ghost-memory"
        ]
      }
    },
    "/api/v1/namespaces/{namespace_id}/artifacts/{artifact_id}": {
      "get": {
        "operationId": "ghost_get_artifact",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactEnvelopeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Fetch one encrypted artifact",
        "tags": [
          "ghost-memory"
        ]
      }
    },
    "/api/v1/namespaces/{namespace_id}/erase": {
      "post": {
        "operationId": "ghost_erase_namespace",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EraseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErasureResultOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Erase the namespace (deletion capability only, idempotent)",
        "tags": [
          "ghost-erasure"
        ]
      }
    },
    "/api/v1/namespaces/{namespace_id}/erasure": {
      "get": {
        "operationId": "ghost_get_erasure",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErasureResultOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retrieve the recorded erasure result",
        "tags": [
          "ghost-erasure"
        ]
      }
    },
    "/api/v1/namespaces/{namespace_id}/status": {
      "get": {
        "operationId": "ghost_get_namespace_status",
        "parameters": [
          {
            "in": "path",
            "name": "namespace_id",
            "required": true,
            "schema": {
              "title": "Namespace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NamespaceStatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read-only owner-scoped namespace status with the real artifact count",
        "tags": [
          "ghost-memory"
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "operationId": "ghost_create_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create an anonymous demo session",
        "tags": [
          "ghost-auth"
        ]
      }
    }
  }
}
